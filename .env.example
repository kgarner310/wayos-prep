# WAYOS PREP — Environment Variables
# Copy to .env and fill in values before running.

# Application
APP_ENV=development

# Database (Supabase recommended for production)
# Local dev: postgresql://wayos:wayos@localhost:5432/wayos_prep
# Supabase:  postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Authentication
JWT_SECRET_KEY=

# API Keys (optional — app works without, uses deterministic fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Redis (optional — app works without)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# LLM settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini

# Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# File upload limit (bytes, default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# =============================================================
# DEPLOYMENT NOTES (AWS ECS/Fargate)
# =============================================================
# 1. Infrastructure: see infra/ directory (Terraform)
# 2. Secrets: stored in AWS Secrets Manager (DATABASE_URL, REDIS_URL,
#    JWT_SECRET_KEY, OPENAI_API_KEY) — injected into ECS task at runtime
# 3. Set APP_ENV=production via ECS task definition environment
# 4. CORS_ORIGINS: set to your domain (e.g., https://app.wayos.ai)
# 5. Generate JWT_SECRET_KEY: openssl rand -hex 32
# 6. CI/CD: push to main triggers GitHub Actions → ECR → ECS deploy
