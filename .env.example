# WAYOS PREP — Environment Variables
# Copy to .env and fill in values before running.

# Application
APP_ENV=development

# Database
DATABASE_URL=
POSTGRES_USER=wayos
POSTGRES_PASSWORD=
POSTGRES_DB=wayos_prep

# Authentication
JWT_SECRET_KEY=

# API Keys (optional — app works without, uses deterministic fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Redis (optional — app works without)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# LLM settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini

# Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# File upload limit (bytes, default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
