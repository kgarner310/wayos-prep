# WAYOS PREP — Environment Variables
# Copy to .env and fill in values before running.

# Application
APP_ENV=development

# Database (Supabase recommended for production)
# Local dev: postgresql://wayos:wayos@localhost:5432/wayos_prep
# Supabase:  postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Authentication
JWT_SECRET_KEY=

# API Keys (optional — app works without, uses deterministic fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Redis (optional — app works without)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# LLM settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini

# Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# PORT is auto-set by Railway in production — do not set locally
# PORT=

# File upload limit (bytes, default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# =============================================================
# DEPLOYMENT NOTES (Railway + Supabase)
# =============================================================
# 1. Create a Supabase project at https://supabase.com
# 2. Copy the "Connection string (URI)" from Project Settings → Database
# 3. Set DATABASE_URL to that URI (uses pooler on port 6543)
# 4. SSL is auto-enabled for supabase.com hostnames
# 5. On Railway: PORT is set automatically (do not hardcode)
# 6. Set APP_ENV=production
# 7. Generate JWT_SECRET_KEY: openssl rand -hex 32
# 8. Set CORS_ORIGINS to your Railway app URL (https://xxx.railway.app)
