# Database
POSTGRES_USER=wayos
POSTGRES_PASSWORD=wayos_dev_password
POSTGRES_DB=wayos_prep
DATABASE_URL=postgresql://wayos:wayos_dev_password@db:5432/wayos_prep

# LLM Provider: openai | anthropic | none
LLM_PROVIDER=none

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Frontend
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
