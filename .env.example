# Database
POSTGRES_USER=wayos
POSTGRES_PASSWORD=wayos_dev_password
POSTGRES_DB=wayos_prep
DATABASE_URL=postgresql://wayos:wayos_dev_password@db:5432/wayos_prep

# OpenAI (required for embeddings + brief generation)
OPENAI_API_KEY=sk-your-key-here

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM model for brief generation + tagging
LLM_MODEL=gpt-4o-mini

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
