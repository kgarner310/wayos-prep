# Database
POSTGRES_USER=wayos
POSTGRES_PASSWORD=wayos_dev_password
POSTGRES_DB=wayos_prep
DATABASE_URL=postgresql://wayos:wayos_dev_password@db:5432/wayos_prep

# LLM Provider: openai | anthropic | none
LLM_PROVIDER=none

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS: comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Auth: set a strong key for production; leave empty to disable (dev only)
WAYOS_API_KEY=

# Rate limiting: requests per minute per IP (0 = disabled)
RATE_LIMIT_RPM=60

# Database connection pool
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Frontend (Outlook Add-in)
# Override API URL in browser: window.__WAYOS_API_URL__ = "http://your-server:8000"
# Override API key in browser: window.__WAYOS_API_KEY__ = "your-key"
