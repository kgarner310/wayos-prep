{
  "expo": {
    "name": "WAYOS PREP",
    "slug": "wayos-prep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "wayosprep",
    "splash": {
      "backgroundColor": "#1B2A4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wayosprep.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A4A"
      },
      "package": "com.wayosprep.app"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
